# All local features run without keys or remote accounts.
DATABASE_URL=sqlite:///./storage/papermind.db
STORAGE_DIR=./storage
# Optional OpenAI-compatible generation. Keys stay on the backend.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini
# Use a localhost binding unless you add an access-control layer.
# ALLOWED_HOSTS=["papermind.example.com"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MAX_UPLOAD_MB=25
MAX_PDF_PAGES=50
MAX_PAPERS=150
