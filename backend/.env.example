# Postgres. Local docker-compose, or a hosted instance (Supabase works).
DATABASE_URL=postgresql+psycopg://papermind:papermind@localhost:5432/papermind

# Qdrant. Local docker-compose, Qdrant Cloud, or ":memory:" for tests.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# Local ONNX models. See app/ml/registry.py for the available keys.
# Leave LOW_MEMORY unset (or false) on a laptop so the MiniLM reranker loads.
# The live Render service sets LOW_MEMORY=true because 512 MB cannot hold both models.
EMBEDDING_MODEL=arctic-embed-xs-int8
RERANKER_MODEL=ms-marco-minilm-l6-int8
LOW_MEMORY=false
MODEL_CACHE_DIR=./.models

# Optional. Any OpenAI-compatible chat endpoint. Leave empty to run in
# extractive mode (retrieval and reranking still work).
# OPENAI_API_KEY is accepted as an alias for LLM_API_KEY.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=gpt-4o-mini

CORS_ORIGINS=["http://localhost:5173"]
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
ENVIRONMENT=development
