# Postgres. Local dev uses the docker-compose service, production should
# point at a Supabase (or similar) connection string.
DATABASE_URL=postgresql+psycopg://papermind:papermind@localhost:5432/papermind

# Qdrant. Local dev uses the docker-compose service, production should
# point at a Qdrant Cloud cluster URL and API key.
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# OpenAI
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
GENERATION_MODEL=gpt-4o-mini
JUDGE_MODEL=gpt-4o-mini

# Comma-free JSON list, matches pydantic-settings list parsing
CORS_ORIGINS=["http://localhost:5173"]

ENVIRONMENT=development
